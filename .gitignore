# ════════════════════════════════════════════════════════════════
#  .gitignore  —  HackathonPremierLeague
#  Only source code is pushed. Credentials, deps, and build
#  artifacts are NEVER committed.
# ════════════════════════════════════════════════════════════════

# ── 1. CREDENTIALS & ENVIRONMENT VARIABLES ──────────────────────
# Never commit secrets, API keys, or environment config.
.env
.env.*
!.env.example
*.local
env/
secrets/
*.secret
*.key
*.pem
*.p12
*.pfx
service-account*.json
firebase-*.json
google-credentials*.json

# ── 2. DEPENDENCIES ─────────────────────────────────────────────
# Install fresh via `npm install` — never commit node_modules.
node_modules/
.pnp
.pnp.js
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz

# ── 3. BUILD OUTPUT ─────────────────────────────────────────────
dist/
dist-ssr/
build/
out/
.output/

# ── 4. LOGS ─────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ── 5. OS & EDITOR JUNK ─────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ── 6. TEMPORARY / SCRATCH ASSETS ───────────────────────────────
src/assets/cropper.py
src/assets/py_check.txt
src/assets/mock_dimensions.json
src/assets/png_info.json
src/assets/ps_ref_clean.png
src/assets/ps_original_mock.jpg
src/assets/ps_01_weathergpt.png
src/assets/ps_02_rural_market.png
src/assets/ps_03_hourglass.png
src/assets/ps_03_mystery_box.png
src/assets/ps_hourglass.png
src/assets/ps_mystery_box.png
src/assets/ps_mystery_box_mobile.png
src/assets/ps_rural_market.png
src/assets/ps_rural_market_mobile.png
src/assets/ps_weathergpt.png
src/assets/ps_weathergpt_mobile.png

# ── 7. MISC & AI METADATA ────────────────────────────────────────
.cache/
.temp/
*.tmp
.gemini/
.antigravity/
coverage/

